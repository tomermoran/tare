# Copy to .env.local. Locally the database is a SQLite file in ./data.
DATABASE_URL=file:./data/tare.db
# Only needed for a hosted libSQL (Turso) database.
DATABASE_AUTH_TOKEN=

# Firebase web app config (Project settings → General → Your apps → Web app).
# Public by design: these ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account (Project settings → Service accounts → Generate new
# private key). Secret: server only, never committed. Copy three fields from the
# downloaded JSON; keep the private key in double quotes with its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
